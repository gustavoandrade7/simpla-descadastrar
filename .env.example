# ActiveCampaign (obrigatório)
ACTIVECAMPAIGN_API_URL=https://1milhaocom30.api-us1.com
ACTIVECAMPAIGN_API_KEY=

# Aliases aceitos: ACTIVE_API_BASE / ACTIVE_API_TOKEN

PORT=3847
# Em prod atrás do nginx path /descadastrar:
# BASE_PATH=/descadastrar

# Tag a aplicar (match case-insensitive)
DESCADASTRAR_TAG_NAME=descadastrar

# Login básico (default admin/admin)
DESCADASTRAR_USER=admin
DESCADASTRAR_PASS=admin
# Opcional: segredo do token (senão deriva user+pass)
# DESCADASTRAR_AUTH_SECRET=